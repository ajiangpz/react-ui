{
  "name": "@tendaui/theme-generator",
  "version": "1.3.5",
  "description": "TendaUI 主题配置生成器",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "style": "dist/theme-generator.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/theme-generator.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": ["**/*.css"],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "publish:public": "npm publish --access public"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@tendaui/react": "workspace:^",
    "@tendaui/icons": "workspace:*",
    "cssbeautify": "^0.3.1",
    "lodash-es": "^4.17.21",
    "react-transition-group": "~4.4.1",
    "tvision-color": "^1.6.0"
  },
  "devDependencies": {
    "@types/cssbeautify": "^0.3.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "^5.0.0",
    "vite": "^7.1.7"
  },
  "peerDependencies": {
    "react": ">=16.13.1",
    "react-dom": ">=16.13.1"
  }
}
